#!/usr/bin/env php
<?php

declare(strict_types=1);

require __DIR__ . '/../vendor/autoload.php';

use ThinkUpgrade\Console\AnalyzeCommand;
use ThinkUpgrade\Console\MigrateCommand;
use ThinkUpgrade\Console\ServeCommand;
use ThinkUpgrade\Console\TransformCommand;
use Symfony\Component\Console\Application;

$app = new Application('ThinkPHP-Upgrade', '0.3.0');
$app->add(new AnalyzeCommand());
$app->add(new TransformCommand());
$app->add(new MigrateCommand());
$app->add(new ServeCommand());
$app->run();
