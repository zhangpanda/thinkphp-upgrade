#!/usr/bin/env php
<?php

declare(strict_types=1);

require __DIR__ . '/../vendor/autoload.php';

use PHPLift\Console\AnalyzeCommand;
use PHPLift\Console\MigrateCommand;
use PHPLift\Console\TransformCommand;
use Symfony\Component\Console\Application;

$app = new Application('PHPLift', '0.1.0');
$app->add(new AnalyzeCommand());
$app->add(new TransformCommand());
$app->add(new MigrateCommand());
$app->run();
